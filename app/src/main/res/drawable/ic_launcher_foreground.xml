<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: neon ball jumping over a magenta triangle, drawn as vectors. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- horizon line -->
    <path
        android:pathData="M18,74 L90,74"
        android:strokeColor="#7A2CFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- grid lines -->
    <path
        android:pathData="M54,74 L30,96 M54,74 L54,96 M54,74 L78,96 M24,84 L84,84"
        android:strokeColor="#4A1A9E"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />

    <!-- triangle glow + outline -->
    <path
        android:pathData="M60,74 L72,52 L84,74 Z"
        android:strokeColor="#66FF2BD6"
        android:strokeWidth="6"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M60,74 L72,52 L84,74 Z"
        android:strokeColor="#FF2BD6"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round" />

    <!-- ball glow + body -->
    <path
        android:pathData="M40,48 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
        android:fillColor="#4D00F0FF" />
    <path
        android:pathData="M40,48 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"
        android:fillColor="#00F0FF" />
    <path
        android:pathData="M40,48 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#CCFFFFFF" />
</vector>
